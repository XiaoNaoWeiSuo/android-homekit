#!/data/data/com.termux/files/usr/bin/bash

# Safe low-power server profile for rooted Android/Termux.
# Does not disable Xiaomi/QTI thermal services or force CPU/GPU frequencies.

STATE_DIR="$HOME/.server-mode"
STATE_FILE="$STATE_DIR/state"
mkdir -p "$STATE_DIR"

as_root() { su -c "$*"; }

status() {
  echo "server-mode: $(as_root 'settings get global low_power 2>/dev/null') (low_power)"
  echo "adaptive_battery: $(as_root 'settings get global adaptive_battery_management_enabled 2>/dev/null')"
  echo "wifi_scan_always_available: $(as_root 'settings get global wifi_scan_always_available 2>/dev/null')"
  echo "thermal_services:"
  as_root "getprop init.svc.android.thermal-hal; getprop init.svc.mi_thermald"
  if command -v termux-wake-unlock >/dev/null 2>&1; then
    echo "wake-lock: use 'server-mode wake-lock on|off' to control it"
  fi
}

save_once() {
  [ -f "$STATE_FILE" ] && return
  {
    echo "low_power=$(as_root 'settings get global low_power 2>/dev/null')"
    echo "adaptive=$(as_root 'settings get global adaptive_battery_management_enabled 2>/dev/null')"
    echo "wifi_scan=$(as_root 'settings get global wifi_scan_always_available 2>/dev/null')"
  } > "$STATE_FILE"
}

on_mode() {
  save_once
  # Battery Saver is reversible and leaves thermal protection intact.
  as_root 'settings put global low_power 1'
  as_root 'settings put global adaptive_battery_management_enabled 1'
  # Prevent background Wi-Fi scanning from waking the radio repeatedly.
  as_root 'settings put global wifi_scan_always_available 0'
  echo "server-mode enabled"
  echo "Thermal HAL/mi_thermald remain enabled; CPU/GPU frequencies were not forced."
}

off_mode() {
  if [ ! -f "$STATE_FILE" ]; then
    echo "No saved state; nothing changed."
    exit 0
  fi
  while IFS='=' read -r key value; do
    case "$key" in
      low_power) [ "$value" != "null" ] && as_root "settings put global low_power $value";;
      adaptive) [ "$value" != "null" ] && as_root "settings put global adaptive_battery_management_enabled $value";;
      wifi_scan) [ "$value" != "null" ] && as_root "settings put global wifi_scan_always_available $value";;
    esac
  done < "$STATE_FILE"
  rm -f "$STATE_FILE"
  echo "server-mode disabled; previous settings restored"
}

wake() {
  [ "$1" = on ] && termux-wake-lock && echo "wake-lock enabled" && exit 0
  [ "$1" = off ] && termux-wake-unlock && echo "wake-lock disabled" && exit 0
  echo "Usage: server-mode wake-lock on|off" >&2
  exit 2
}

case "$1" in
  on) on_mode;;
  off) off_mode;;
  status) status;;
  wake-lock) wake "$2";;
  *)
    echo "Usage: server-mode {on|off|status|wake-lock on|off}" >&2
    exit 2
    ;;
esac
