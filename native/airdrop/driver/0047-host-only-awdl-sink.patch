--- a/qcacld-3.0/core/hdd/src/wlan_hdd_power.c
+++ b/qcacld-3.0/core/hdd/src/wlan_hdd_power.c
@@ -93,6 +93,7 @@
 #include <wlan_cp_stats_mc_ucfg_api.h>
 #include "wlan_dp_ucfg_api.h"
 #include "qdf_lock.h"
+#include "marionette_monitor_rx_observe.h"
 
 /* Preprocessor definitions and constants */
 #ifdef QCA_WIFI_EMULATION
@@ -1936,6 +1937,10 @@ QDF_STATUS hdd_wlan_shutdown(void)
 
 	hdd_lpass_notify_stop(hdd_ctx);
 
+	/* The host-only AWDL sink netdev lives inside this module; it must be
+	 * unregistered before the module can be unloaded. */
+	marionette_awdl_sink_exit();
+
 	qdf_set_smmu_fault_state(false);
 	hdd_info("WLAN driver shutdown complete");
 
