diff --git a/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c b/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c
--- a/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c
