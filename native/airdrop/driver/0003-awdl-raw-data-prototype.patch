 }
 
+
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+/* Diagnostic only: this does not implement management TX or coexistence.
+ * Keep off until module ABI and firmware behavior have been verified. */
+static bool marionette_awdl_raw_tx;
+module_param_named(marionette_awdl_raw_tx, marionette_awdl_raw_tx, bool, 0600);
+MODULE_PARM_DESC(marionette_awdl_raw_tx,
+                "Experimental AWDL-only monitor data TX; default off");
+
+netdev_tx_t hdd_mon_awdl_start_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	static const u8 radiotap_prefix[] = { 0, 0, 13, 0, 4, 128, 2, 0, 24, 0 };
+	static const u8 awdl_bssid[] = { 0, 0x25, 0, 0xff, 0x94, 0x73 };
+	static const u8 awdl_snap[] = { 0xaa, 0xaa, 3, 0, 0x17, 0xf2, 8, 0, 3, 4 };
+	struct hdd_adapter *adapter;
+	ol_txrx_soc_handle soc;
+	struct cdp_tx_exception_metadata metadata = {0};
+	u8 *frame;
+	unsigned int bytes;
+
+	hdd_dp_ssr_protect();
+	adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	/* Only filin's known radiotap layout and plain IPv6 AWDL data frames.
+	 * Management frames require a separate, verified WMI submission path. */
+	if (!READ_ONCE(marionette_awdl_raw_tx) ||
+	    cds_get_conparam() != QDF_GLOBAL_MONITOR_MODE ||
+	    adapter->device_mode != QDF_MONITOR_MODE ||
+	    adapter->vdev_id == 0xff || skb->len < 13 + 24 + 16 + 40 ||
+	    skb->len > 13 + 2304 || skb_linearize(skb) ||
+	    skb_cow_head(skb, 128))
+		goto drop;
+	frame = skb->data + 13;
+	if (memcmp(skb->data, radiotap_prefix, sizeof(radiotap_prefix)) ||
+	    (skb->data[10] != 0 && skb->data[10] != 8) || skb->data[11] ||
+	    frame[0] != 8 || frame[1] || (frame[22] & 0x0f) ||
+	    !ether_addr_equal(frame + 10, adapter->mac_addr.bytes) ||
+	    !ether_addr_equal(frame + 16, awdl_bssid) ||
+	    memcmp(frame + 24, awdl_snap, sizeof(awdl_snap)) ||
+	    frame[38] != 0x86 || frame[39] != 0xdd ||
+	    (frame[40] >> 4) != 6)
+		goto drop;
+	soc = cds_get_context(QDF_MODULE_ID_SOC);
+	/* cdp_tx_send_exc treats an absent callback as NULL/success. Check it
+	 * explicitly so a missing datapath never produces a false TX count. */
+	if (!soc || !soc->ops || !soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->tx_send_exc)
+		goto drop;
+	skb_pull(skb, 13);
+	memset(skb->cb, 0, sizeof(skb->cb));
+	bytes = skb->len;
+	metadata.peer_id = CDP_INVALID_PEER;
+	metadata.tid = 0;
+	metadata.tx_encap_type = htt_cmn_pkt_type_raw;
+	metadata.sec_type = cdp_sec_type_none;
+	skb = cdp_tx_send_exc(soc, adapter->vdev_id, skb, &metadata);
+	if (skb)
+		goto drop;
+	/* Submission counters only. Firmware/OTA completion is still unknown. */
+	dev->stats.tx_packets++;
+	dev->stats.tx_bytes += bytes;
+	hdd_dp_ssr_unprotect();
+	return NETDEV_TX_OK;
+drop:
+	dev->stats.tx_dropped++;
+	dev_kfree_skb_any(skb);
+	hdd_dp_ssr_unprotect();
+	return NETDEV_TX_OK;
+}
+#endif
+
