-	if (marionette_awdl_fw_promisc) {
-		wmi_handle = get_wmi_unified_hdl_from_psoc(hdd_ctx->psoc);
-		if (!wmi_handle || !hdd_ctx->pdev) {
-			ret = -ENODEV;
-			goto stop;
-		}
-		pdev_id = wlan_objmgr_pdev_get_pdev_id(hdd_ctx->pdev);
-		promisc_enable_status = marionette_wmi_rx_promiscuous(
-					wmi_handle, pdev_id, true);
-	}
 	WRITE_ONCE(marionette_capture_phase, true);
-	capture_status = QDF_IS_STATUS_SUCCESS(promisc_enable_status) ?
-		marionette_monitor_refresh_filters(soc) : promisc_enable_status;
+	capture_status = marionette_monitor_refresh_filters(soc);
 	if (QDF_IS_STATUS_SUCCESS(capture_status)) {
 		if (target_freq != home_freq)
 			tune_status = wlan_hdd_set_mon_chan(adapter, target_freq,
@@ -20102,20 +20146,12 @@ static int marionette_capture_once_set(const char *value,
 	/* Restore even after a failed/partial channel request. */
 	if (target_freq != home_freq)
