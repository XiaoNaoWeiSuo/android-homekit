From: Marionette AirDrop driver research
Subject: [EXPERIMENTAL] decode mission shared-ring monitor with its observed RX prefix

0026 located 10 exact AWDL signatures in valid DMA buffers at offset 272,
which equals soc->rx_pkt_tlv_size. The HAL monitor header pointer was 288
(16 bytes into the actual frame, reading AWDL BSSID as FC=0x2500), while
soc->rx_mon_pkt_tlv_size was 400. The presumed header-TLV tag at 272 was
actually raw FC/duration/broadcast DA (0xffffffff000000d0). Input/output
counts matched but reconstruction skipped/corrupted the real frame header.
Under the existing default-off STA-monitor experiment only, for KIWI mission
mode with shared RXDMA and non-RAW resources, select the normal RX prefix
only for the exact observed 272/400-byte layout. No private HAL struct
layout is imported into the generic DP translation unit. This
keeps monitor buffer popping/restitching consistent with observed physical
layout. Global monitor, other targets, dedicated rings, RAW resources and
normal STA RX size are unchanged. No firmware/hardware writes or RAW TX.
Actual full-frame AWDL reception and Wi-Fi behavior still require runtime proof.

diff --git a/qca-wifi-host-cmn/dp/wifi3.0/dp_main.c b/qca-wifi-host-cmn/dp/wifi3.0/dp_main.c
--- a/qca-wifi-host-cmn/dp/wifi3.0/dp_main.c
+++ b/qca-wifi-host-cmn/dp/wifi3.0/dp_main.c
@@ -17,6 +17,8 @@
  * PERFORMANCE OF THIS SOFTWARE.
  */
 
+#include "marionette_sta_monitor.h"
+#include "marionette_rx_resources.h"
 #include <wlan_ipa_obj_mgmt_api.h>
 #include <qdf_types.h>
 #include <qdf_lock.h>
@@ -15119,6 +15121,24 @@
 	}
 	dp_soc_cfg_attach(soc);
 
+	if (marionette_sta_monitor_enabled() &&
+	    !marionette_raw_rx_resources_enabled() &&
+	    hal_get_target_type(soc->hal_soc) == TARGET_TYPE_KIWI &&
+	    !soc->wlan_cfg_ctx->rxdma1_enable && ol_ops &&
+	    ol_ops->get_con_mode &&
+	    ol_ops->get_con_mode() == QDF_GLOBAL_MISSION_MODE &&
+	    soc->rx_pkt_tlv_size == 272 &&
+	    soc->rx_mon_pkt_tlv_size == 400) {
+		/* Captured mission/shared-ring buffers contain the normal RX
+		 * prefix followed immediately by the raw 802.11 frame. They do
+		 * not carry the extra monitor packet-header TLV. Using the
+		 * global-monitor prefix skipped 128 bytes of each actual frame. */
+		pr_info("MARIONETTE_MISSION_MONITOR_PREFIX normal=%u old_monitor=%u selected=%u\n",
+			soc->rx_pkt_tlv_size, soc->rx_mon_pkt_tlv_size,
+			soc->rx_pkt_tlv_size);
+		soc->rx_mon_pkt_tlv_size = soc->rx_pkt_tlv_size;
+	}
+
 	if (dp_hw_link_desc_pool_banks_alloc(soc, WLAN_INVALID_PDEV_ID)) {
 		dp_err("failed to allocate link desc pool banks");
 		goto fail3;
