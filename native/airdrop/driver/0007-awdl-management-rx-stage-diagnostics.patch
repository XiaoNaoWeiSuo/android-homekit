 	0x7f, 0x00, 0x17, 0xf2, 0x08, 0x10
 };
 
+/* Default-off RX-stage counters, shared inside this WLAN module only. */
+static atomic_long_t marionette_mgmt_rx_stages[MARIONETTE_AWDL_RX_STAGE_COUNT];
+static atomic_long_t marionette_awdl_rx_stages[MARIONETTE_AWDL_RX_STAGE_COUNT];
+static int marionette_rx_counter_get(char *buffer,
+				     const struct kernel_param *parameter)
+{
+	return scnprintf(buffer, PAGE_SIZE, "%ld\n",
+			 atomic_long_read(parameter->arg));
+}
+static const struct kernel_param_ops marionette_rx_counter_ops = {
+	.get = marionette_rx_counter_get,
+};
+module_param_cb(marionette_mgmt_rx_wmi, &marionette_rx_counter_ops,
+		&marionette_mgmt_rx_stages[0], 0400);
+module_param_cb(marionette_awdl_rx_wmi, &marionette_rx_counter_ops,
+		&marionette_awdl_rx_stages[0], 0400);
+module_param_cb(marionette_mgmt_rx_lim, &marionette_rx_counter_ops,
+		&marionette_mgmt_rx_stages[1], 0400);
+module_param_cb(marionette_awdl_rx_lim, &marionette_rx_counter_ops,
+		&marionette_awdl_rx_stages[1], 0400);
+module_param_cb(marionette_mgmt_rx_hdd, &marionette_rx_counter_ops,
+		&marionette_mgmt_rx_stages[2], 0400);
+module_param_cb(marionette_awdl_rx_hdd, &marionette_rx_counter_ops,
+		&marionette_awdl_rx_stages[2], 0400);
+
+void marionette_awdl_rx_observe(enum marionette_awdl_rx_stage stage,
+			      const u8 *frame, u32 len)
+{
+	static const u8 bssid[] = {0, 0x25, 0, 0xff, 0x94, 0x73};
+
+	if (!marionette_awdl_mgmt_rx || stage >= MARIONETTE_AWDL_RX_STAGE_COUNT ||
+	    !frame || len < 24)
+		return;
+	atomic_long_inc(&marionette_mgmt_rx_stages[stage]);
+	if (len >= 40 && frame[0] == 0xd0 && !(frame[1] & 0x40) &&
+	    !memcmp(frame + 16, bssid, sizeof(bssid)) &&
+	    !memcmp(frame + 24, marionette_awdl_action_prefix,
+		    sizeof(marionette_awdl_action_prefix)) &&
+	    (frame[30] == 0 || frame[30] == 3))
+		atomic_long_inc(&marionette_awdl_rx_stages[stage]);
+}
