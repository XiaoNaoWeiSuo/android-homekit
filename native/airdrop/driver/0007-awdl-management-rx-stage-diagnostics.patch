+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MARIONETTE_AWDL_RX_DIAGNOSTICS_H
+#define MARIONETTE_AWDL_RX_DIAGNOSTICS_H
+#include <linux/types.h>
+enum marionette_awdl_rx_stage {
+	MARIONETTE_AWDL_RX_WMI,
+	MARIONETTE_AWDL_RX_LIM,
+	MARIONETTE_AWDL_RX_HDD,
+	MARIONETTE_AWDL_RX_STAGE_COUNT,
+};
+/* Observation only; never changes ownership or forwards a packet. */
+void marionette_awdl_rx_observe(enum marionette_awdl_rx_stage stage,
+			      const u8 *frame, u32 len);
+#endif
