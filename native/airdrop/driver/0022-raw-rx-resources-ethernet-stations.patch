@@ -25,6 +25,7 @@
  */
 
 /* Include Files */
+#include "marionette_rx_resources.h"
 #include "wlan_vdev_mgr_utils_api.h"
 #include "marionette_wmi_rx_filter.h"
 #include "marionette_sta_monitor.h"
@@ -12895,6 +12896,34 @@
  *
  * Return: 0 on success or errno on failure.
  */
+/* Set each STA vdev, including internal link adapters, explicitly to
+ * Ethernet before association when RAW resource defaults are being tested. */
+static int marionette_set_station_ethernet_rx(struct hdd_adapter *adapter)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct vdev_mlme_obj *mlme;
+	struct wlan_vdev_mgr_cfg config = { .value = htt_cmn_pkt_type_ethernet };
+	QDF_STATUS status;
+
+	if (!marionette_raw_rx_resources_enabled() ||
+	    adapter->device_mode != QDF_STA_MODE)
+		return 0;
+	vdev = hdd_objmgr_get_vdev_by_user(adapter, WLAN_OSIF_P2P_ID);
+	if (!vdev)
+		return -ENODEV;
+	mlme = wlan_vdev_mlme_get_cmpt_obj(vdev);
+	if (!mlme) {
+		hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_P2P_ID);
+		return -ENODEV;
+	}
+	status = wlan_util_vdev_mlme_set_param(mlme,
+				WLAN_MLME_CFG_RX_DECAP_TYPE, config);
+	hdd_info("MARIONETTE_STA_ETHERNET_RX vdev=%u type=%u queued_status=%u",
+		 adapter->vdev_id, config.value, status);
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_P2P_ID);
+	return qdf_status_to_os_return(status);
+}
+
 int hdd_start_station_adapter(struct hdd_adapter *adapter)
 {
 	QDF_STATUS status;
@@ -12921,6 +12950,10 @@
 		hdd_err("Error Initializing station mode: %d", status);
 		return qdf_status_to_os_return(status);
 	}
+
+	ret = marionette_set_station_ethernet_rx(adapter);
+	if (ret)
+		return ret;
 
 	hdd_register_tx_flow_control(adapter,
 		hdd_tx_resume_timer_expired_handler,
