-	p[3] = 0;
-	p[4] = 0x08;
+	p[2] = rtap & 0xff;
+	p[3] = (rtap >> 8) & 0xff;
+	p[4] = tsft ? 0x09 : 0x08;
 	p[5] = 0;
 	p[6] = 0;
