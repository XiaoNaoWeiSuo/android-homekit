+	p = skb_put(skb, rtap + length);
+	/*
+	 * radiotap: version 0, present = TSFT|CHANNEL when the descriptor
+	 * carried a timestamp, CHANNEL alone otherwise.  TSFT is 8-byte
+	 * aligned and therefore lands at offset 8; the channel follows at 16
