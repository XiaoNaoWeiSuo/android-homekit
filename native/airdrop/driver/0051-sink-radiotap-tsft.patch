+		p[16] = marionette_awdl_sink_freq & 0xff;
+		p[17] = (marionette_awdl_sink_freq >> 8) & 0xff;
+		p[18] = 0;
+		p[19] = 0;
+		memset(p + 20, 0, 4);
+	} else {
