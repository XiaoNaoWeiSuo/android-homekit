+static void dp_mon_vdev_timer_start(struct dp_soc *soc)
+{
+	struct dp_mon_soc *mon_soc = soc->monitor_soc;
+
+	if (!(READ_ONCE(mon_soc->mon_vdev_timer_state) & MON_VDEV_TIMER_INIT))
+		return;
+	qdf_spin_lock_bh(&mon_soc->mon_vdev_timer_lock);
+	if ((mon_soc->mon_vdev_timer_state & MON_VDEV_TIMER_INIT) &&
+	    !mon_soc->mon_vdev_timer_stoppers) {
+		mon_soc->mon_vdev_timer_state |= MON_VDEV_TIMER_RUNNING;
+		qdf_timer_mod(&mon_soc->mon_vdev_timer, DP_INTR_POLL_TIMER_MS);
+	}
+	qdf_spin_unlock_bh(&mon_soc->mon_vdev_timer_lock);
+}
+
+static bool dp_mon_vdev_timer_stop(struct dp_soc *soc)
+{
+	struct dp_mon_soc *mon_soc = soc->monitor_soc;
+	bool was_running;
+
+	if (!(READ_ONCE(mon_soc->mon_vdev_timer_state) & MON_VDEV_TIMER_INIT))
+		return false;
+	qdf_spin_lock_bh(&mon_soc->mon_vdev_timer_lock);
+	if (!(mon_soc->mon_vdev_timer_state & MON_VDEV_TIMER_INIT)) {
+		qdf_spin_unlock_bh(&mon_soc->mon_vdev_timer_lock);
+		return false;
+	}
+	was_running = !!(mon_soc->mon_vdev_timer_state & MON_VDEV_TIMER_RUNNING);
+	mon_soc->mon_vdev_timer_state &= ~MON_VDEV_TIMER_RUNNING;
+	mon_soc->mon_vdev_timer_stoppers++;
+	qdf_spin_unlock_bh(&mon_soc->mon_vdev_timer_lock);
+
+	/* Even a second concurrent stop must join any executing callback. */
+	qdf_timer_sync_cancel(&mon_soc->mon_vdev_timer);
+
+	qdf_spin_lock_bh(&mon_soc->mon_vdev_timer_lock);
+	mon_soc->mon_vdev_timer_stoppers--;
+	qdf_spin_unlock_bh(&mon_soc->mon_vdev_timer_lock);
+	return was_running;
 }
 
