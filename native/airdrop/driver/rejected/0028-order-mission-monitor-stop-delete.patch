 	if (vdev)
@@ -512,6 +514,28 @@
 
 	if (!soc) {
 		status = QDF_STATUS_E_FAILURE;
+		goto rel_ref;
+	}
+
+	if (marionette_sta_monitor_enabled() &&
+	    cds_get_conparam() == QDF_GLOBAL_MISSION_MODE &&
+	    !qdf_is_recovering() && iface->vdev &&
+	    wlan_vdev_mlme_get_opmode(iface->vdev) == QDF_MONITOR_MODE &&
+	    wlan_vdev_mlme_get_state(iface->vdev) == WLAN_VDEV_S_UP) {
+		/* DOWN issues asynchronous STOP. Keep the existing WMA object
+		 * reference until its response (or existing timeout callback),
+		 * so object destruction cannot issue DELETE while STOP is live.
+		 * Do not block the scheduler that processes the response. */
+		iface->marionette_monitor_detach_pending = true;
+		status = wlan_vdev_mlme_sm_deliver_evt(iface->vdev,
+						      WLAN_VDEV_SM_EV_DOWN,
+						      0, NULL);
+		if (QDF_IS_STATUS_SUCCESS(status)) {
+			wma_info("MARIONETTE_MONITOR_DETACH_WAIT_STOP vdev=%u",
+				 vdev_id);
+			return status;
+		}
+		iface->marionette_monitor_detach_pending = false;
 		goto rel_ref;
 	}
 
@@ -2596,11 +2620,28 @@
 	if (!wma)
 		return status;
 
-	iface = &wma->interfaces[vdev_mlme->vdev->vdev_objmgr.vdev_id];
-
 	if (rsp->vdev_id >= wma->max_bssid) {
 		wma_err("Invalid vdev_id %d from FW", rsp->vdev_id);
 		return QDF_STATUS_E_INVAL;
+	}
+
+	iface = &wma->interfaces[rsp->vdev_id];
+	if (iface->marionette_monitor_detach_pending) {
+		void *soc = cds_get_context(QDF_MODULE_ID_SOC);
+
+		/* The target-if response handler has stopped the STOP timer.
+		 * Complete monitor DOWN before dropping the retained reference
+		 * and allowing the normal object destructor to send DELETE.
+		 * Its existing timeout/recovery path reaches this callback too. */
+		iface->marionette_monitor_detach_pending = false;
+		status = QDF_STATUS_SUCCESS;
+		if (!qdf_is_recovering())
+			status = wma_send_vdev_down_to_fw(wma, rsp->vdev_id);
+		wma_info("MARIONETTE_MONITOR_DETACH_AFTER_STOP vdev=%u down=%d recovery=%u",
+			 rsp->vdev_id, status, qdf_is_recovering());
+		wma_cdp_vdev_detach(soc, wma, rsp->vdev_id);
+		wma_release_vdev_ref(iface);
+		return status;
 	}
 
 	status = wma_handle_vdev_stop_rsp(wma, rsp);
