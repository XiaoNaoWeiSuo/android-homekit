+static bool marionette_monitor_is_awdl(const u8 *frame, u32 length)
+{
+	static const u8 bssid[] = {0, 0x25, 0, 0xff, 0x94, 0x73};
+	static const u8 prefix[] = {0x7f, 0, 0x17, 0xf2, 8, 0x10};
+
+	return length >= 40 && frame[0] == 0xd0 && !(frame[1] & 0x40) &&
+		!memcmp(frame + 16, bssid, sizeof(bssid)) &&
+		!memcmp(frame + 24, prefix, sizeof(prefix)) &&
+		(frame[30] == 0 || frame[30] == 3);
+}
+static void marionette_monitor_header(struct dp_soc *soc, const u8 *descriptor,
+				      u16 metadata_fc)
+{
+	struct hal_soc *hal = (struct hal_soc *)soc->hal_soc;
+	const u8 *header;
+	long offset;
+	u32 i, length = soc->rx_mon_pkt_tlv_size;
+	u16 header_fc;
+	u64 tag = 0;
+
+	if (!hal->ops->hal_rx_desc_get_80211_hdr || length < 40) {
+		atomic_long_inc(&marionette_mon_hdr_unavailable);
+		return;
+	}
+	header = hal_rx_desc_get_80211_hdr(soc->hal_soc, (void *)descriptor);
+	offset = (long)(header - descriptor);
+	if (!header || offset < 16 || offset > length - 40) {
+		atomic_long_inc(&marionette_mon_hdr_unavailable);
+		return;
+	}
+	header_fc = (u16)header[0] | ((u16)header[1] << 8);
+	if (header_fc == metadata_fc)
+		atomic_long_inc(&marionette_mon_hdr_fc_match);
+	if (header[0] == 0xd0)
+		atomic_long_inc(&marionette_mon_hdr_action);
+	if (marionette_monitor_is_awdl(header, length - offset))
+		atomic_long_inc(&marionette_mon_hdr_awdl);
+	/* Search only the already-present monitor descriptor/TLV region. This
+	 * is observation, not a new header selection or reconstruction rule. */
+	for (i = 0; i <= length - 40; i++) {
+		if (marionette_monitor_is_awdl(descriptor + i, length - i)) {
+			atomic_long_inc(&marionette_mon_tlv_awdl);
+			pr_info("MARIONETTE_MON_TLV_AWDL offset=%u hal_offset=%ld\n", i, offset);
+			break;
+		}
+	}
+	if ((metadata_fc & 0x00fc) == 0x00d0 &&
+	    atomic_long_read(&marionette_mon_desc_action) <= 8) {
+		memcpy(&tag, header - 16, sizeof(tag));
+		pr_info("MARIONETTE_MON_ACTION_LAYOUT metadata_fc=0x%x header_fc=0x%x offset=%ld tlv_tag=0x%llx normal_size=%u monitor_size=%u\n",
+			metadata_fc, header_fc, offset, (unsigned long long)tag,
+			soc->rx_pkt_tlv_size, soc->rx_mon_pkt_tlv_size);
+	}
+}
+
 
