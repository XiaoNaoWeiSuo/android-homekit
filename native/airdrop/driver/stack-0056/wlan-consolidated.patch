+static bool marionette_awdl_data_frame(const uint8_t *buf, uint32_t length)
+{
+	if (!READ_ONCE(marionette_awdl_data_tx))
+		return false;
+	if (length < P2P_ACTION_OFFSET + 16)
+		return false;
+	/* type 2 == data, and the AWDL LLC/SNAP right after the 24-byte header */
+	if (P2P_GET_TYPE_FRM_FC(buf[0]) != 2)
+		return false;
+	return !qdf_mem_cmp(buf + P2P_ACTION_OFFSET, marionette_awdl_snap,
+			    sizeof(marionette_awdl_snap));
