+/*
+ * Host-only AWDL receive sink.
+ *
+ * Holding a monitor vdev open next to an associated station kills this
+ * firmware: cnss reports "Driver recovery is triggered with reason: RDDM(2)"
+ * within 5-25 s (measured 2026-10-23).  The monitor RX ring does not need
+ * that vdev, though -- AWDL action frames still reach
+ * marionette_monitor_post_frame() with no monitor vdev present.  Hand them to
+ * a netdev that exists only on the host instead: userspace keeps a plain
+ * AF_PACKET reader (tcpdump works unchanged) and the firmware is never told
+ * that a monitor session was requested.
+ */
+#define MARIONETTE_SINK_NAME "awdlsink"
+#define MARIONETTE_SINK_RTAP 12
+#define MARIONETTE_SINK_RTAP_TSFT 24
+
+static bool marionette_awdl_sink = true;
+module_param_named(marionette_awdl_sink, marionette_awdl_sink, bool, 0600);
+MODULE_PARM_DESC(marionette_awdl_sink,
+		 "Deliver AWDL action frames to the host-only awdlsink netdev");
+
+static unsigned int marionette_awdl_sink_freq = 5260;
+module_param_named(marionette_awdl_sink_freq, marionette_awdl_sink_freq,
+		   uint, 0600);
+MODULE_PARM_DESC(marionette_awdl_sink_freq,
+		 "Frequency reported in the sink's radiotap header");
+
+static atomic_long_t marionette_awdl_sink_rx = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_awdl_sink_drop = ATOMIC_LONG_INIT(0);
+module_param_cb(marionette_awdl_sink_rx, &marionette_mon_counter_ops,
+		&marionette_awdl_sink_rx, 0400);
+module_param_cb(marionette_awdl_sink_drop, &marionette_mon_counter_ops,
+		&marionette_awdl_sink_drop, 0400);
+
+static atomic_long_t marionette_mon_post_data = ATOMIC_LONG_INIT(0);
+module_param_cb(marionette_mon_post_data, &marionette_mon_counter_ops,
+		&marionette_mon_post_data, 0400);
+
+static struct net_device *marionette_sink_dev;
+static void marionette_sink_create(struct work_struct *work);
+static DECLARE_WORK(marionette_sink_work, marionette_sink_create);
+
+static netdev_tx_t marionette_sink_xmit(struct sk_buff *skb,
+					struct net_device *dev)
+{
+	kfree_skb(skb);
+	return NETDEV_TX_OK;
+}
+
+static const struct net_device_ops marionette_sink_ops = {
+	.ndo_start_xmit = marionette_sink_xmit,
+};
+
+static void marionette_sink_setup(struct net_device *dev)
+{
+	dev->type = ARPHRD_IEEE80211_RADIOTAP;
+	dev->hard_header_len = 0;
+	dev->addr_len = 0;
+	dev->mtu = 2304;
+	dev->tx_queue_len = 0;
+	dev->flags |= IFF_NOARP;
+}
+
+/*
+ * Reclaim a netdev that a previous module instance left behind.
+ *
+ * The sink is created lazily and destroyed in marionette_awdl_sink_exit(),
+ * which used to be reachable only from hdd_wlan_shutdown().  When the module
+ * was replaced without that path running, the old netdev stayed registered and
+ * register_netdevice() returned -EEXIST for ever: the sink pointer stayed
+ * NULL, every frame was counted in marionette_awdl_sink_drop, and the result
+ * was indistinguishable from "no peer nearby" (measured 2026-10-23:
+ * post_awdl=288, sink_rx=0, sink_drop=288).
+ *
+ * The orphan cannot be reused -- its netdev_ops point into the previous module
+ * image -- and it must be unregistered without holding a reference, because
+ * unregister waits for the refcount to reach zero.  Take no reference at all:
+ * walk the list under rtnl and hand the devices to unregister_netdevice_many,
+ * which is the kernel's own idiom.  dev_get_by_name()/dev_change_name() are
+ * not exported to modules on this kernel, so they are not an option.
+ */
+static void marionette_sink_reclaim(void)
+{
+	struct net_device *dev, *tmp;
+	LIST_HEAD(gone);
+
+	rtnl_lock();
+	for_each_netdev_safe(&init_net, dev, tmp) {
+		if (strcmp(dev->name, MARIONETTE_SINK_NAME))
+			continue;
+		pr_info("MARIONETTE_AWDL_SINK_RECLAIM ifindex=%d\n",
+			dev->ifindex);
+		unregister_netdevice_queue(dev, &gone);
+	}
+	if (!list_empty(&gone))
+		unregister_netdevice_many(&gone);
+	rtnl_unlock();
+}
+
+static void marionette_sink_create(struct work_struct *work)
+{
+	struct net_device *dev;
+	int ret = -ENODEV;
+	int attempt;
+
+	if (READ_ONCE(marionette_sink_dev))
+		return;
+	for (attempt = 0; attempt < 10; attempt++) {
+		dev = alloc_netdev(0, MARIONETTE_SINK_NAME, NET_NAME_UNKNOWN,
+				   marionette_sink_setup);
+		if (!dev)
+			return;
+		dev->netdev_ops = &marionette_sink_ops;
+		rtnl_lock();
+		ret = register_netdevice(dev);
+		if (!ret)
+			ret = dev_open(dev, NULL);
+		rtnl_unlock();
+		if (!ret)
+			break;
+		free_netdev(dev);
+		pr_info("MARIONETTE_AWDL_SINK_UP_FAILED ret=%d attempt=%d\n",
+			ret, attempt);
+		if (ret == -EEXIST)
+			marionette_sink_reclaim();
+		msleep(20);
+	}
+	if (ret) {
+		pr_info("MARIONETTE_AWDL_SINK_GAVE_UP ret=%d\n", ret);
+		return;
+	}
+	WRITE_ONCE(marionette_sink_dev, dev);
+	pr_info("MARIONETTE_AWDL_SINK_UP dev=%s freq=%u\n",
+		dev->name, marionette_awdl_sink_freq);
+}
+
+void marionette_awdl_sink_exit(void)
+{
+	struct net_device *dev = READ_ONCE(marionette_sink_dev);
+
+	cancel_work_sync(&marionette_sink_work);
+	if (!dev)
+		return;
+	WRITE_ONCE(marionette_sink_dev, NULL);
+	rtnl_lock();
+	dev_close(dev);
+	unregister_netdevice(dev);
+	rtnl_unlock();
+	pr_info("MARIONETTE_AWDL_SINK_DOWN\n");
+}
+
+static void marionette_awdl_sink_deliver(const u8 *frame, u32 length,
+					 u64 tsft)
+{
+	struct net_device *dev = READ_ONCE(marionette_sink_dev);
+	struct sk_buff *skb;
+	u32 rtap = tsft ? MARIONETTE_SINK_RTAP_TSFT : MARIONETTE_SINK_RTAP;
+	u8 *p;
+	int i;
+
+	if (!dev) {
+		schedule_work(&marionette_sink_work);
+		atomic_long_inc(&marionette_awdl_sink_drop);
+		return;
+	}
+	skb = netdev_alloc_skb(dev, rtap + length);
+	if (!skb) {
+		atomic_long_inc(&marionette_awdl_sink_drop);
+		return;
+	}
+	p = skb_put(skb, rtap + length);
+	/*
+	 * radiotap: version 0, present = TSFT|CHANNEL when the descriptor
+	 * carried a timestamp, CHANNEL alone otherwise.  TSFT is 8-byte
+	 * aligned and therefore lands at offset 8; the channel follows at 16
+	 * and the header is padded to 24 so the 802.11 header stays 8-byte
+	 * aligned for readers that care.
+	 *
+	 * Without TSFT filin falls back to host time, which leaves
+	 * tsf_offset_us at 0 and aw_alignment_pct at 0: peer discovery works
+	 * but the availability windows never line up.
+	 */
+	p[0] = 0;
+	p[1] = 0;
+	p[2] = rtap & 0xff;
+	p[3] = (rtap >> 8) & 0xff;
+	p[4] = tsft ? 0x09 : 0x08;
+	p[5] = 0;
+	p[6] = 0;
+	p[7] = 0;
+	if (tsft) {
+		for (i = 0; i < 8; i++)
+			p[8 + i] = (tsft >> (8 * i)) & 0xff;
+		p[16] = marionette_awdl_sink_freq & 0xff;
+		p[17] = (marionette_awdl_sink_freq >> 8) & 0xff;
+		p[18] = 0;
+		p[19] = 0;
+		memset(p + 20, 0, 4);
+	} else {
+		p[8] = marionette_awdl_sink_freq & 0xff;
+		p[9] = (marionette_awdl_sink_freq >> 8) & 0xff;
+		p[10] = 0;
+		p[11] = 0;
+	}
+	memcpy(p + rtap, frame, length);
+	skb->dev = dev;
+	skb->protocol = htons(ETH_P_ALL);
+	skb_reset_mac_header(skb);
+	netif_rx(skb);
+	atomic_long_inc(&marionette_awdl_sink_rx);
+}
+
+static bool marionette_monitor_is_awdl(const u8 *frame, u32 length)
+{
+	static const u8 bssid[] = {0, 0x25, 0, 0xff, 0x94, 0x73};
+	static const u8 prefix[] = {0x7f, 0, 0x17, 0xf2, 8, 0x10};
+
+	return length >= 40 && frame[0] == 0xd0 && !(frame[1] & 0x40) &&
+		!memcmp(frame + 16, bssid, sizeof(bssid)) &&
+		!memcmp(frame + 24, prefix, sizeof(prefix)) &&
+		(frame[30] == 0 || frame[30] == 3);
+}
+static void marionette_monitor_header(struct dp_soc *soc, const u8 *descriptor,
+				      u16 metadata_fc)
+{
+	struct hal_soc *hal = (struct hal_soc *)soc->hal_soc;
+	const u8 *header;
+	long offset;
+	u32 i, length = soc->rx_mon_pkt_tlv_size;
+	u16 header_fc;
+	u64 tag = 0;
+
+	if (!hal->ops->hal_rx_desc_get_80211_hdr || length < 40) {
+		atomic_long_inc(&marionette_mon_hdr_unavailable);
+		return;
+	}
+	header = hal_rx_desc_get_80211_hdr(soc->hal_soc, (void *)descriptor);
+	offset = (long)(header - descriptor);
+	if (!header || offset < 16 || offset > length - 40) {
+		atomic_long_inc(&marionette_mon_hdr_unavailable);
+		return;
+	}
+	header_fc = (u16)header[0] | ((u16)header[1] << 8);
+	if (header_fc == metadata_fc)
+		atomic_long_inc(&marionette_mon_hdr_fc_match);
+	if (header[0] == 0xd0)
+		atomic_long_inc(&marionette_mon_hdr_action);
+	if (marionette_monitor_is_awdl(header, length - offset))
+		atomic_long_inc(&marionette_mon_hdr_awdl);
+	/* Search only the already-present monitor descriptor/TLV region. This
+	 * is observation, not a new header selection or reconstruction rule. */
+	for (i = 0; i <= length - 40; i++) {
+		if (marionette_monitor_is_awdl(descriptor + i, length - i)) {
+			atomic_long_inc(&marionette_mon_tlv_awdl);
+			pr_info("MARIONETTE_MON_TLV_AWDL offset=%u hal_offset=%ld\n", i, offset);
+			break;
+		}
+	}
+	if ((metadata_fc & 0x00fc) == 0x00d0 &&
+	    atomic_long_read(&marionette_mon_desc_action) <= 8) {
+		memcpy(&tag, header - 16, sizeof(tag));
+		pr_info("MARIONETTE_MON_ACTION_LAYOUT metadata_fc=0x%x header_fc=0x%x offset=%ld tlv_tag=0x%llx normal_size=%u monitor_size=%u\n",
+			metadata_fc, header_fc, offset, (unsigned long long)tag,
+			soc->rx_pkt_tlv_size, soc->rx_mon_pkt_tlv_size);
+	}
+}
+
+
+static void marionette_monitor_descriptor(struct dp_soc *soc, void *descriptor)
+{
+	struct hal_soc *hal;
+	u16 fc;
+
+	if (!marionette_sta_monitor_enabled() ||
+	    !descriptor)
+		return;
+	atomic_long_inc(&marionette_mon_desc_total);
+	hal = (struct hal_soc *)soc->hal_soc;
+	if (!hal || !hal->ops ||
+	    !hal->ops->hal_rx_get_mpdu_frame_control_valid ||
+	    !hal->ops->hal_rx_get_frame_ctrl_field) {
+		atomic_long_inc(&marionette_mon_missing_hal_ops);
+		return;
+	}
+	if (!hal_rx_get_mpdu_frame_control_valid(soc->hal_soc, descriptor))
+		return;
+	atomic_long_inc(&marionette_mon_desc_valid_fc);
+	fc = hal_rx_get_frame_ctrl_field(soc->hal_soc, descriptor);
+	switch (fc & 0x0c) {
+	case 0:
+		atomic_long_inc(&marionette_mon_desc_mgmt);
+		if ((fc & 0xf0) == 0xd0)
+			atomic_long_inc(&marionette_mon_desc_action);
+		break;
+	case 4:
+		atomic_long_inc(&marionette_mon_desc_control);
+		break;
+	case 8:
+		atomic_long_inc(&marionette_mon_desc_data);
+		break;
+	}
+	marionette_monitor_header(soc, descriptor, fc);
+}
+void marionette_monitor_post_frame(const u8 *frame, u32 length, u64 tsft)
+{
+	if (!marionette_sta_monitor_enabled() ||
+	    !frame || length < 2)
+		return;
+	atomic_long_inc(&marionette_mon_post_total);
+	if (frame[0] != 0xd0) {
+		static const u8 awdl_bssid[] = {0, 0x25, 0, 0xff, 0x94, 0x73};
+
+		/*
+		 * AWDL data frames -- the ones carrying mDNS and, later, the
+		 * AirDrop payload -- are QoS data with the AWDL BSSID in addr3.
+		 * They never carry the action prefix, so the predicate below
+		 * cannot classify them; without this branch the sink only ever
+		 * sees PSF/MIF and filin reports mdns_rx_other = 0.
+		 */
+		if ((frame[0] & 0x0c) != 0x08 || length < 24 ||
+		    memcmp(frame + 16, awdl_bssid, sizeof(awdl_bssid)))
+			return;
+		atomic_long_inc(&marionette_mon_post_data);
+		if (marionette_awdl_sink)
+			marionette_awdl_sink_deliver(frame, length, tsft);
+		return;
+	}
+	atomic_long_inc(&marionette_mon_post_action);
+	if (!marionette_monitor_is_awdl(frame, length))
+		return;
+	atomic_long_inc(&marionette_mon_post_awdl);
+	if (marionette_awdl_sink)
+		marionette_awdl_sink_deliver(frame, length, tsft);
+}
