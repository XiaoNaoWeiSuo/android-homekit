+/* Keep one logical STA restriction while accounting for its internal MLO
+ * link vdevs. Only the explicit monitor experiment uses this observation. */
+static uint8_t marionette_monitor_sta_count(struct wlan_objmgr_psoc *psoc,
+					  uint8_t opened)
+{
+#ifdef WLAN_FEATURE_11BE_MLO
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_mlo_dev_context *group = NULL;
+	uint16_t id;
+	uint8_t total = 0, roots = 0, links = 0;
+	bool same_group = true;
+
+	if (!marionette_sta_monitor_enabled() || opened <= 1)
+		return opened;
+	for (id = 0; id < WLAN_UMAC_PSOC_MAX_VDEVS; id++) {
+		vdev = wlan_objmgr_get_vdev_by_id_from_psoc(psoc, id,
+							 WLAN_POLICY_MGR_ID);
+		if (!vdev)
+			continue;
+		if (wlan_vdev_mlme_get_opmode(vdev) == QDF_STA_MODE) {
+			bool link = wlan_vdev_mlme_is_mlo_link_vdev(vdev);
+
+			total++;
+			if (link)
+				links++;
+			else
+				roots++;
+			if (!vdev->mlo_dev_ctx)
+				same_group = false;
+			else if (!group)
+				group = vdev->mlo_dev_ctx;
+			else if (group != vdev->mlo_dev_ctx)
+				same_group = false;
+			policy_mgr_info("MARIONETTE_MON_STA_VDEV id=%u link=%u mlo=%u",
+				id, link, wlan_vdev_mlme_is_mlo_vdev(vdev));
+		}
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_POLICY_MGR_ID);
+	}
+	policy_mgr_info("MARIONETTE_MON_STA_COUNT opened=%u objects=%u roots=%u links=%u same_mld=%u",
+			opened, total, roots, links, same_group);
+	/* Legacy APs clear role flags (mlo_mld_clear_mlo_cap) while the MLD
+	 * still owns the internal vdevs. Count that complete MLD once. */
+	if (total && total <= opened && group && same_group &&
+	    group->wlan_vdev_count == total &&
+	    !qdf_is_macaddr_zero(&group->mld_addr) &&
+	    !qdf_is_macaddr_group(&group->mld_addr))
+		return 1;
+#endif
+	return opened;
+}
