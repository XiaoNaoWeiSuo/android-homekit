+/*
+ * A PDEV component pointer is not itself a lifetime reference.  DBR firmware
+ * events can arrive while the object manager is running the PDEV destroy
+ * callback, so take a small explicit user reference while touching the
+ * component.  The PDEV object lock serializes the lookup with the destroy
+ * gate; the component lock serializes module state transitions.
+ */
+static bool target_if_dbr_user_get(struct wlan_objmgr_pdev *pdev,
+				   struct direct_buf_rx_pdev_obj **out)
+{
+	struct direct_buf_rx_pdev_obj *obj;
+	int users;
+
+	if (!pdev || !out)
+		return false;
+
+	wlan_pdev_obj_lock(pdev);
+	obj = wlan_objmgr_pdev_get_comp_private_obj(
+			pdev, WLAN_TARGET_IF_COMP_DIRECT_BUF_RX);
+	if (!obj) {
+		wlan_pdev_obj_unlock(pdev);
+		return false;
+	}
+
+	qdf_spin_lock_bh(&obj->lifecycle_lock);
+	if (obj->destroying) {
+		qdf_spin_unlock_bh(&obj->lifecycle_lock);
+		wlan_pdev_obj_unlock(pdev);
+		return false;
+	}
+	users = qdf_atomic_inc_return(&obj->active_users);
+	if (users == 1)
+		qdf_event_reset(&obj->users_zero);
+	if (users == 2)
+		qdf_event_reset(&obj->users_idle);
+	*out = obj;
+	qdf_spin_unlock_bh(&obj->lifecycle_lock);
+	wlan_pdev_obj_unlock(pdev);
+	return true;
+}
+
+static void target_if_dbr_user_put(struct direct_buf_rx_pdev_obj *obj)
+{
+	int users;
+
+	if (!obj)
+		return;
+	users = qdf_atomic_dec_return(&obj->active_users);
+	if (users <= 1)
+		qdf_event_set(&obj->users_idle);
+	if (users == 0)
+		qdf_event_set(&obj->users_zero);
+}
