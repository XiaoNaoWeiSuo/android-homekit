+	con_mode = cds_get_conparam();
+	drop_site = 0;
+	if (!READ_ONCE(marionette_awdl_raw_tx)) {
+		drop_site = 1;
+		goto drop;
+	}
+	if (con_mode != QDF_GLOBAL_MONITOR_MODE &&
+	    con_mode != QDF_GLOBAL_MISSION_MODE) {
+		drop_site = 2;
+		goto drop;
+	}
+	if (adapter->device_mode != QDF_MONITOR_MODE) {
+		drop_site = 3;
+		goto drop;
+	}
+	if (adapter->vdev_id == 0xff) {
+		drop_site = 4;
+		goto drop;
+	}
+	if (skb->len < 13 + 24 + 16 + 40 ||
+	    skb->len > 13 + 2304 ||
+	    skb_linearize(skb) || skb_cow_head(skb, 128)) {
+		drop_site = 5;
+		goto drop;
+	}
+	frame = skb->data + 13;
+	if (memcmp(skb->data, radiotap_prefix, sizeof(radiotap_prefix))) {
+		drop_site = 6;
+		goto drop;
