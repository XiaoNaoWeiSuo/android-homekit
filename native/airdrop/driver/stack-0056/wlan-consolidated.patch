+	if (skb->data[10] != 0 && skb->data[10] != 8) {
+		drop_site = 7;
+		goto drop;
+	}
+	if (skb->data[11]) {
+		drop_site = 8;
+		goto drop;
+	}
+	if (frame[0] != 8 || frame[1]) {
+		drop_site = 9;
+		goto drop;
+	}
+	if (frame[22] & 0x0f) {
+		drop_site = 10;
+		goto drop;
+	}
+	if (!ether_addr_equal(frame + 10, adapter->mac_addr.bytes)) {
+		drop_site = 11;
+		goto drop;
+	}
+	if (!ether_addr_equal(frame + 16, awdl_bssid)) {
+		drop_site = 12;
+		goto drop;
+	}
+	if (memcmp(frame + 24, awdl_snap, sizeof(awdl_snap))) {
+		drop_site = 13;
+		goto drop;
+	}
+	if (frame[38] != 0x86 || frame[39] != 0xdd ||
+	    (frame[40] >> 4) != 6) {
+		drop_site = 14;
+		goto drop;
+	}
+	soc = cds_get_context(QDF_MODULE_ID_SOC);
+	/* cdp_tx_send_exc treats an absent callback as NULL/success. Check it
+	 * explicitly so a missing datapath never produces a false TX count. */
+	if (!soc || !soc->ops || !soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->tx_send_exc) {
+		drop_site = 15;
+		goto drop;
+	}
+	skb_pull(skb, 13);
+	memset(skb->cb, 0, sizeof(skb->cb));
+	bytes = skb->len;
+	metadata.peer_id = CDP_INVALID_PEER;
+	metadata.tid = 0;
+	metadata.tx_encap_type = htt_cmn_pkt_type_raw;
+	metadata.sec_type = cdp_sec_type_none;
+	skb = cdp_tx_send_exc(soc, adapter->vdev_id, skb, &metadata);
+	if (skb)
+		goto drop;
+	/* Submission counters only. Firmware/OTA completion is still unknown. */
+	atomic_long_inc(&marionette_awdl_submitted);
+	atomic_long_add(bytes, &marionette_awdl_submitted_bytes);
+	hdd_dp_ssr_unprotect();
+	return NETDEV_TX_OK;
+drop:
+	atomic_long_inc(&marionette_awdl_rejected);
+	marionette_awdl_drop_site(skb, drop_site);
+	dev_kfree_skb_any(skb);
+	hdd_dp_ssr_unprotect();
+	return NETDEV_TX_OK;
+}
