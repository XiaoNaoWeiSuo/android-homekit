+/* Called only with the monitor vdev operation guard held by the bounded
+ * experiment. Never cache the SoC or queue work across teardown. */
+int marionette_monitor_refresh_filters(void *soc_handle, bool hold)
+{
+	struct dp_soc *soc = soc_handle;
+	struct dp_pdev *pdev;
+
+	if (!marionette_sta_monitor_enabled() || !soc)
+		return QDF_STATUS_E_NOSUPPORT;
+	pdev = soc->pdev_list[0];
+	if (!pdev || !pdev->monitor_pdev ||
+	    !pdev->monitor_pdev->monitor_configured ||
+	    !pdev->monitor_pdev->mvdev)
+		return QDF_STATUS_E_INVAL;
+	/* Releasing must actually release.
+	 *
+	 * This used to install the monitor filters unconditionally, so writing
+	 * capture_hold=0 re-armed them and normal RX never came back: the
+	 * station missed beacons and policy manager dropped the link after a
+	 * run of them (QCA_DISCONNECT_REASON_BEACON_MISS_FAILURE, ~10 s).
+	 * Only deleting the monitor vdev restored normal RX, which is why the
+	 * service had to churn vdevs -- and every vdev delete costs one
+	 * target_if_vdev_mgr assertion because the firmware's STOP response is
+	 * never accounted for.
+	 *
+	 * Resetting the monitor mode puts the shared RXDMA ring back to its
+	 * normal interpretation, which is what the detach path does.
+	 */
+	if (!hold)
+		dp_mon_filter_reset_mon_mode_1_0(pdev);
+	else
+		dp_mon_filter_setup_mon_mode_1_0(pdev);
+	return dp_mon_filter_update_1_0(pdev);
+}
