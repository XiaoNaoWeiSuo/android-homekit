+/* Called only with an existing object reference. The SME legacy reference
+ * stays owned by the original delete transaction until its normal response. */
+static struct wma_txrx_node *
+wma_mon_delete_iface(struct wlan_objmgr_vdev *vdev)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	uint8_t id;
+
+	if (!wma || !vdev ||
+	    wlan_vdev_mlme_get_opmode(vdev) != QDF_MONITOR_MODE)
+		return NULL;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid || wma->interfaces[id].vdev != vdev)
+		return NULL;
+	return &wma->interfaces[id];
+}
+
+/* Run after the outer SM delivery returned, never from its nested callbacks.
+ * In this pinned build START/STOP responses and timer expiry are serialized
+ * on the MC thread (SERIALIZE_VDEV_RESP). Do not add a wait on that thread. */
+void wma_mon_resume_delete(struct wlan_objmgr_vdev *vdev)
+{
+	struct wma_txrx_node *iface = wma_mon_delete_iface(vdev);
+	mac_handle_t mac;
+	QDF_STATUS status;
+	uint8_t id;
+
+	if (!iface || cmpxchg(&iface->monitor_delete_state,
+		WMA_MON_DELETE_READY, WMA_MON_DELETE_RESUMED) !=
+		WMA_MON_DELETE_READY)
+		return;
+
+	id = wlan_vdev_get_id(vdev);
+	status = READ_ONCE(iface->monitor_stop_status);
+	wma_info("MARIONETTE_MONITOR_STOP_COMPLETE vdev=%u status=%d recovery=%u",
+		 id, status, qdf_is_recovering());
+	if (QDF_IS_STATUS_ERROR(status) && !qdf_is_recovering())
+		cds_trigger_recovery(QDF_VDEV_STOP_RESPONSE_TIMED_OUT);
+
+	mac = cds_get_context(QDF_MODULE_ID_SME);
+	if (!mac) {
+		wma_err("Monitor delete continuation has no SME vdev=%u", id);
+		return;
+	}
+	/* RESUMED bypasses the gate; no recursion into STOP. */
+	status = sme_vdev_delete(mac, vdev);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Monitor delete continuation failed vdev=%u status=%d", id, status);
+		if (!qdf_is_recovering())
+			cds_trigger_recovery(QDF_REASON_UNSPECIFIED);
+	}
+}
+
+bool wma_mon_stop_before_delete(struct wlan_objmgr_vdev *vdev)
+{
+	struct wma_txrx_node *iface;
+	QDF_STATUS status;
+	unsigned int state;
+
+#ifndef SERIALIZE_VDEV_RESP
+	/* The continuation can acquire the SME mutex. This build requires MC
+	 * serialization; never run it directly from a softirq timeout. */
+	return false;
+#endif
+	if (!marionette_sta_monitor_enabled())
+		return false;
+	iface = wma_mon_delete_iface(vdev);
+	if (!iface)
+		return false;
+	state = READ_ONCE(iface->monitor_delete_state);
+	if (state == WMA_MON_DELETE_RESUMED)
+		return false;
+	if (state != WMA_MON_DELETE_IDLE)
+		return true;
+	if (qdf_is_recovering() ||
+	    wlan_vdev_mlme_get_state(vdev) == WLAN_VDEV_S_INIT)
+		return false;
+
+	if (cmpxchg(&iface->monitor_delete_state, WMA_MON_DELETE_IDLE,
+		    WMA_MON_DELETE_WAIT) != WMA_MON_DELETE_IDLE)
+		return true;
+	WRITE_ONCE(iface->monitor_stop_status, QDF_STATUS_SUCCESS);
+
+	/* A synchronous failure/INIT transition can finish deletion recursively.
+	 * Keep a temporary ref until this stack has completely unwound. */
+	wlan_objmgr_vdev_get_ref(vdev, WLAN_LEGACY_WMA_ID);
+	wma_info("MARIONETTE_MONITOR_STOP_BEFORE_DELETE vdev=%u", wlan_vdev_get_id(vdev));
+	status = wlan_vdev_mlme_sm_deliver_evt(vdev, WLAN_VDEV_SM_EV_DOWN,
+					      0, NULL);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		WRITE_ONCE(iface->monitor_stop_status, status);
+		cmpxchg(&iface->monitor_delete_state,
+			WMA_MON_DELETE_WAIT, WMA_MON_DELETE_READY);
+	}
+	wma_mon_resume_delete(vdev);
+	wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+	return true;
+}
+
+QDF_STATUS wma_mon_down_complete(struct vdev_mlme_obj *mlme,
+				 uint16_t data_len, void *data)
+{
+	struct wma_txrx_node *iface = wma_mon_delete_iface(mlme->vdev);
+
+	if (iface)
+		cmpxchg(&iface->monitor_delete_state,
+			WMA_MON_DELETE_WAIT, WMA_MON_DELETE_READY);
+	/* Only mark completion here: the caller still owns the SM lock. */
+	return QDF_STATUS_SUCCESS;
+}
+
+bool wma_mon_delete_start_response(struct vdev_mlme_obj *mlme,
+				   struct vdev_start_response *rsp)
+{
+	struct wma_txrx_node *iface;
+	enum wlan_vdev_sm_evt event;
+	QDF_STATUS status;
+	bool restart;
+
+	if (!mlme || !mlme->vdev || !rsp ||
+	    wlan_vdev_get_id(mlme->vdev) != rsp->vdev_id)
+		return false;
+	iface = wma_mon_delete_iface(mlme->vdev);
+	if (!iface || READ_ONCE(iface->monitor_delete_state) != WMA_MON_DELETE_WAIT)
+		return false;
+
+	restart = rsp->resp_type == WMI_VDEV_RESTART_RESP_EVENT;
+	mlme_set_chan_switch_in_progress(mlme->vdev, false);
+	if (rsp->status) {
+		WRITE_ONCE(iface->monitor_stop_status, QDF_STATUS_E_FAILURE);
+		event = restart ? WLAN_VDEV_SM_EV_RESTART_REQ_FAIL :
+				  WLAN_VDEV_SM_EV_START_REQ_FAIL;
+	} else {
+		event = restart ? WLAN_VDEV_SM_EV_RESTART_RESP :
+				  WLAN_VDEV_SM_EV_START_RESP;
+	}
+	status = wlan_vdev_mlme_sm_deliver_evt(mlme->vdev, event,
+					      sizeof(*rsp), rsp);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		WRITE_ONCE(iface->monitor_stop_status, status);
+		cmpxchg(&iface->monitor_delete_state,
+			WMA_MON_DELETE_WAIT, WMA_MON_DELETE_READY);
+	}
+	wma_mon_resume_delete(mlme->vdev);
+	return true;
+}
+
+QDF_STATUS wma_mon_stop_response(struct vdev_mlme_obj *mlme,
+				 struct vdev_stop_response *rsp)
+{
+	struct wma_txrx_node *iface;
+	QDF_STATUS status;
+
+	if (!mlme || !rsp || !mlme->vdev ||
+	    wlan_vdev_get_id(mlme->vdev) != rsp->vdev_id)
+		return QDF_STATUS_E_INVAL;
+	iface = wma_mon_delete_iface(mlme->vdev);
+	if (!iface || READ_ONCE(iface->monitor_delete_state) != WMA_MON_DELETE_WAIT)
+		return QDF_STATUS_E_INVAL;
+
+	/* target-if already cleared STOP_RESPONSE_BIT and balanced its psoc ref.
+	 * A timeout/SSR flush carries failure, not a fabricated firmware ack. */
+	if (QDF_IS_STATUS_ERROR(rsp->status))
+		WRITE_ONCE(iface->monitor_stop_status, rsp->status);
+	status = wlan_vdev_mlme_sm_deliver_evt(mlme->vdev,
+				WLAN_VDEV_SM_EV_MLME_DOWN_REQ, 0, NULL);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		WRITE_ONCE(iface->monitor_stop_status, status);
+		cmpxchg(&iface->monitor_delete_state,
+			WMA_MON_DELETE_WAIT, WMA_MON_DELETE_READY);
+	}
+	wma_mon_resume_delete(mlme->vdev);
+	return status;
+}
