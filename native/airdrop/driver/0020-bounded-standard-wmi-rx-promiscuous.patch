--- a/qca-wifi-host-cmn/wmi/src/wmi_unified_tlv.c
+++ b/qca-wifi-host-cmn/wmi/src/wmi_unified_tlv.c
@@ -17,6 +17,7 @@
  * PERFORMANCE OF THIS SOFTWARE.
  */
 
+#include "marionette_wmi_rx_filter.h"
 #include "wmi_unified_api.h"
 #include "wmi.h"
 #include "wmi_version.h"
@@ -20984,3 +20985,36 @@
 {
 	wmi_unified_register_module(WMI_TLV_TARGET, &wmi_tlv_attach);
 }
+
+/* Isolated research caller; the command and field semantics are defined in
+ * fw-api/fw/wmi_unified.h and its fixed-parameter TLV table. */
+int marionette_wmi_rx_promiscuous(void *handle, u32 pdev_id, bool enable)
+{
+	wmi_unified_t wmi_handle = handle;
+	wmi_pdev_set_rx_filter_promiscuous_cmd_fixed_param *cmd;
+	wmi_buf_t buffer;
+	QDF_STATUS status;
+
+	static_assert(sizeof(*cmd) == 12);
+	if (!wmi_handle || !wmi_handle->ops ||
+	    !wmi_handle->ops->convert_pdev_id_host_to_target)
+		return QDF_STATUS_E_INVAL;
+	buffer = wmi_buf_alloc(wmi_handle, sizeof(*cmd));
+	if (!buffer)
+		return QDF_STATUS_E_NOMEM;
+	cmd = (void *)wmi_buf_data(buffer);
+	qdf_mem_zero(cmd, sizeof(*cmd));
+	WMITLV_SET_HDR(&cmd->tlv_header,
+		WMITLV_TAG_STRUC_wmi_pdev_set_rx_filter_promiscuous_cmd_fixed_param,
+		WMITLV_GET_STRUCT_TLVLEN(wmi_pdev_set_rx_filter_promiscuous_cmd_fixed_param));
+	cmd->pdev_id = wmi_handle->ops->convert_pdev_id_host_to_target(
+						wmi_handle, pdev_id);
+	cmd->rx_filter_promiscuous_enable = enable ? 1 : 0;
+	status = wmi_unified_cmd_send(wmi_handle, buffer, sizeof(*cmd),
+				     WMI_PDEV_SET_RX_FILTER_PROMISCUOUS_CMDID);
+	if (QDF_IS_STATUS_ERROR(status))
+		wmi_buf_free(buffer);
+	pr_info("MARIONETTE_WMI_RX_PROMISCUOUS enable=%u host_pdev=%u queued_status=%u\n",
+		enable, pdev_id, status);
+	return status;
+}
