+/* Observation only; include deferred processing after capture returns. */
+static atomic_long_t marionette_mon_desc_total = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_desc_valid_fc = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_desc_mgmt = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_desc_action = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_desc_data = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_desc_control = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_post_total = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_post_action = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_post_awdl = ATOMIC_LONG_INIT(0);
+static atomic_long_t marionette_mon_missing_hal_ops = ATOMIC_LONG_INIT(0);
+static int marionette_mon_counter_get(char *buffer,
+				      const struct kernel_param *parameter)
+{
+	return scnprintf(buffer, PAGE_SIZE, "%ld\n",
+			 atomic_long_read(parameter->arg));
+}
+static const struct kernel_param_ops marionette_mon_counter_ops = {
+	.get = marionette_mon_counter_get,
+};
+module_param_cb(marionette_mon_desc_total, &marionette_mon_counter_ops,
+		&marionette_mon_desc_total, 0400);
+module_param_cb(marionette_mon_desc_valid_fc, &marionette_mon_counter_ops,
+		&marionette_mon_desc_valid_fc, 0400);
+module_param_cb(marionette_mon_desc_mgmt, &marionette_mon_counter_ops,
+		&marionette_mon_desc_mgmt, 0400);
+module_param_cb(marionette_mon_desc_action, &marionette_mon_counter_ops,
+		&marionette_mon_desc_action, 0400);
+module_param_cb(marionette_mon_desc_data, &marionette_mon_counter_ops,
+		&marionette_mon_desc_data, 0400);
+module_param_cb(marionette_mon_desc_control, &marionette_mon_counter_ops,
+		&marionette_mon_desc_control, 0400);
+module_param_cb(marionette_mon_post_total, &marionette_mon_counter_ops,
+		&marionette_mon_post_total, 0400);
+module_param_cb(marionette_mon_post_action, &marionette_mon_counter_ops,
+		&marionette_mon_post_action, 0400);
+module_param_cb(marionette_mon_post_awdl, &marionette_mon_counter_ops,
+		&marionette_mon_post_awdl, 0400);
+module_param_cb(marionette_mon_missing_hal_ops, &marionette_mon_counter_ops,
+		&marionette_mon_missing_hal_ops, 0400);
+
+static void marionette_monitor_descriptor(struct dp_soc *soc, void *descriptor)
+{
+	struct hal_soc *hal;
+	u16 fc;
+
+	if (!marionette_sta_monitor_enabled() ||
+	    !descriptor)
+		return;
+	atomic_long_inc(&marionette_mon_desc_total);
+	hal = (struct hal_soc *)soc->hal_soc;
+	if (!hal || !hal->ops ||
+	    !hal->ops->hal_rx_get_mpdu_frame_control_valid ||
+	    !hal->ops->hal_rx_get_frame_ctrl_field) {
+		atomic_long_inc(&marionette_mon_missing_hal_ops);
+		return;
+	}
+	if (!hal_rx_get_mpdu_frame_control_valid(soc->hal_soc, descriptor))
+		return;
+	atomic_long_inc(&marionette_mon_desc_valid_fc);
+	fc = hal_rx_get_frame_ctrl_field(soc->hal_soc, descriptor);
+	switch (fc & 0x0c) {
+	case 0:
+		atomic_long_inc(&marionette_mon_desc_mgmt);
+		if ((fc & 0xf0) == 0xd0)
+			atomic_long_inc(&marionette_mon_desc_action);
+		break;
+	case 4:
+		atomic_long_inc(&marionette_mon_desc_control);
+		break;
+	case 8:
+		atomic_long_inc(&marionette_mon_desc_data);
+		break;
+	}
+}
+void marionette_monitor_post_frame(const u8 *frame, u32 length)
+{
+	static const u8 bssid[] = {0, 0x25, 0, 0xff, 0x94, 0x73};
+	static const u8 prefix[] = {0x7f, 0, 0x17, 0xf2, 8, 0x10};
+
+	if (!marionette_sta_monitor_enabled() ||
+	    !frame || length < 2)
+		return;
+	atomic_long_inc(&marionette_mon_post_total);
+	if (frame[0] != 0xd0)
+		return;
+	atomic_long_inc(&marionette_mon_post_action);
+	if (length >= 40 && !(frame[1] & 0x40) &&
+	    !memcmp(frame + 16, bssid, sizeof(bssid)) &&
+	    !memcmp(frame + 24, prefix, sizeof(prefix)) &&
+	    (frame[30] == 0 || frame[30] == 3))
+		atomic_long_inc(&marionette_mon_post_awdl);
+}
 
